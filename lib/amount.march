-- FinanceAmount — Signed, arbitrary-size atom quantities tied to an asset identity and
-- precision. Operations are pure; parsing is exact and rounding occurs only when
-- explicitly requested by rescale. One atom is 10^-precision whole units.
--
-- Usage and tested examples: docs/guide.md and test/docs_quickstart_test.march.

mod FinanceAmount do
  -- Opaque signed BigInt atom count and validated asset. Zero and negative quantities are
  -- permitted; positive-only posting rules belong to ledger.
  opaque type Quantity = QuantityValue(FinanceAsset.Asset, BigInt.BigInt)
  doc """
  Construct q from validated asset a and signed integer units without rounding.
  Infallible; units are atoms, not whole units. For USD precision 2, 1250 atoms formats as
  12.50.
  """
  fn from_atoms(a : FinanceAsset.Asset, units : BigInt.BigInt) : Quantity do
    QuantityValue(a, units)
  end

  doc """
  Return q's signed arbitrary-size atom coefficient. Interpret it using
  quantity_asset(q)'s precision; do not compare counts of different assets as economic
  values.
  """
  fn atoms(q : Quantity) : BigInt.BigInt do
    match q do QuantityValue(_, units) -> units end
  end

  doc """
  Return the validated asset carried by q, including its native accounting precision.
  Infallible and does not alter q.
  """
  fn quantity_asset(q : Quantity) : FinanceAsset.Asset do
    match q do QuantityValue(a, _) -> a end
  end

  doc """
  Return a + b when identity and precision both agree; otherwise return AssetMismatch.
  BigInt addition is exact and permits signed/zero results. Inputs are unchanged.
  """
  fn add(a : Quantity, b : Quantity) : Result(Quantity, FinanceError.Error) do
    let aa = quantity_asset(a)
    let ab = quantity_asset(b)
    if FinanceAsset.asset_id(aa) == FinanceAsset.asset_id(ab) && FinanceAsset.precision(aa) == FinanceAsset.precision(ab) do
      Ok(from_atoms(aa, BigInt.add(atoms(a), atoms(b))))
    else Err(FinanceError.AssetMismatch) end
  end

  doc """
  Return q with the atom sign reversed and asset unchanged. Infallible; zero remains zero
  and no rounding occurs.
  """
  fn negate(q : Quantity) : Quantity do
    from_atoms(quantity_asset(q), BigInt.negate(atoms(q)))
  end

  doc """
  Return a - b, requiring matching asset identity and precision or AssetMismatch.
  Subtraction is exact; a negative result is valid and does not signal insufficient funds.
  """
  fn sub(a : Quantity, b : Quantity) : Result(Quantity, FinanceError.Error) do
    add(a, negate(b))
  end

  pfn digits(s : String) : Bool do
    String.byte_size(s) > 0 && List.all(string_chars(s), fn c -> c >= "0" && c <= "9")
  end

  pfn integer_digits(s : String) : BigInt.BigInt do
    List.fold_left(string_chars(s), BigInt.zero(), fn (acc, c) ->
      let value = match string_to_int(c) do
        Some(n) -> n
        None -> panic("internal decimal digit invariant")
      end
      BigInt.add(BigInt.mul(acc, BigInt.from_int(10)), BigInt.from_int(value)))
  end

  doc """
  Parse text exactly into a's atoms: optional minus, digits, optional dot followed by
  digits. Reject whitespace, plus, exponent or incomplete decimals with InvalidDecimal;
  excess fractional digits (even zeros) yield PrecisionExceeded. Example: parse(usd,
  "12.50").
  """
  fn parse(a : FinanceAsset.Asset, text : String) : Result(Quantity, FinanceError.Error) do
    let negative = String.starts_with(text, "-")
    let body = if negative do String.slice_bytes(text, 1, String.byte_size(text) - 1) else text end
    let parts = String.split(body, ".")
    let parsed = match parts do
      Cons(whole, Nil) ->
        if digits(whole) do Ok((whole, "")) else Err(FinanceError.InvalidDecimal) end
      Cons(whole, Cons(frac, Nil)) ->
        if digits(whole) && digits(frac) do Ok((whole, frac)) else Err(FinanceError.InvalidDecimal) end
      _ -> Err(FinanceError.InvalidDecimal)
    end
    let? pair = parsed
    let (whole, frac) = pair
    let places = FinanceAsset.precision(a)
    if String.byte_size(frac) > places do Err(FinanceError.PrecisionExceeded)
    else
      let units = integer_digits(whole ++ frac ++ String.repeat("0", places - String.byte_size(frac)))
      Ok(from_atoms(a, if negative do BigInt.negate(units) else units end))
    end
  end

  doc """
  Return decimal text padded to q's full native precision, with no exponent. Negative zero
  normalizes to zero. Infallible; this is exact interchange text, not locale-aware
  display.
  """
  fn format(q : Quantity) : String do
    let units = atoms(q)
    let places = FinanceAsset.precision(quantity_asset(q))
    let raw = BigInt.to_string(BigInt.abs(units))
    let padded = String.pad_left(raw, places + 1, "0")
    let n = String.byte_size(padded)
    let sign = if BigInt.is_negative(units) do "-" else "" end
    if places == 0 do sign ++ raw
    else sign ++ String.slice_bytes(padded, 0, n - places) ++ "." ++ String.slice_bytes(padded, n - places, places) end
  end
  doc """
  Return q at places (0..255) for the same asset identity. Increasing precision is exact;
  decreasing it calls the explicit policy. Exact can return Inexact; invalid runtime
  places return InvalidPrecision. Never mutates the original asset or performs currency
  conversion.
  """
  fn rescale(q : Quantity, places : {Int | _ >= 0 && _ <= 255}, policy : FinanceRounding.Policy) : Result(Quantity, FinanceError.Error) do
    let a = quantity_asset(q)
    let? target = FinanceAsset.asset(FinanceAsset.asset_id(a), places)
    let before = FinanceAsset.precision(a)
    if places >= before do
      let delta = places - before
      if delta < 0 || delta > 255 do Err(FinanceError.InvalidPrecision)
      else Ok(from_atoms(target, BigInt.mul(atoms(q), FinanceRounding.power10(delta)))) end
    else
      let delta = before - places
      if delta < 0 || delta > 255 do Err(FinanceError.InvalidPrecision)
      else
        let? units = FinanceRounding.divide(atoms(q), FinanceRounding.power10(delta), policy)
        Ok(from_atoms(target, units))
      end
    end
  end
end
