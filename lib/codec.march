-- FinanceCodec — Strict quantity-only JSON v1. Exact amounts and precision are strings,
-- not floating-point numbers. This module does not serialize journals or prove data
-- authenticity.
--
-- Usage and tested examples: docs/guide.md and test/docs_quickstart_test.march.

mod FinanceCodec do
  doc """
  Encode q as JSON with exactly four string fields: version="1", asset, precision and
  amount. Infallible; amount uses full native precision, preserving arbitrary-size atoms.
  """
  fn encode(q : FinanceAmount.Quantity) : String do
    let a = FinanceAmount.quantity_asset(q)
    Json.to_string(Json.Object([
      ("version", Json.Str("1")),
      ("asset", Json.Str(FinanceAsset.asset_id(a))),
      ("precision", Json.Str(int_to_string(FinanceAsset.precision(a)))),
      ("amount", Json.Str(FinanceAmount.format(q)))
    ]))
  end

  pfn field(value : Json.JsonValue, key : String) : Result(String, FinanceError.Error) do
    match Json.get(value, key) do
      Some(Json.Str(s)) -> Ok(s)
      _ -> Err(FinanceError.InvalidEncoding)
    end
  end

  doc """
  Decode JSON v1 into a validated Quantity. InvalidEncoding for malformed JSON,
  duplicate/missing/extra fields, nonstrings, unsupported version or noncanonical
  precision text. Propagate asset/precision/decimal errors from smart constructors. Signed
  amounts are accepted; no rounding occurs.
  """
  fn decode(text : String) : Result(FinanceAmount.Quantity, FinanceError.Error) do
    let? value = Result.map_err(Json.parse(text), fn _ -> FinanceError.InvalidEncoding)
    let keys = match value do
      Json.Object(pairs) -> List.map(pairs, fn pair -> match pair do (key, _) -> key end)
      _ -> Nil
    end
    if List.length(keys) != 4 || List.length(List.dedup(keys)) != 4 do Err(FinanceError.InvalidEncoding)
    else
      let? version = field(value, "version")
      let? id = field(value, "asset")
      let? places = field(value, "precision")
      let? amount = field(value, "amount")
      if version != "1" do Err(FinanceError.InvalidEncoding)
      else
        match string_to_int(places) do
          None -> Err(FinanceError.InvalidEncoding)
          Some(p) ->
            if int_to_string(p) != places do Err(FinanceError.InvalidEncoding)
            else
              let? a = FinanceAsset.asset(id, p)
              FinanceAmount.parse(a, amount)
            end
        end
      end
    end
  end
end
