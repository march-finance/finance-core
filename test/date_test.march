mod FinanceDateTest do
  test "civil dates validate Gregorian leap years" do
    assert (Result.is_ok(FinanceDate.parse("2024-02-29")))
    assert (Result.is_err(FinanceDate.parse("2023-02-29")))
    assert (Result.is_err(FinanceDate.parse("2024-13-01")))
    assert (Result.is_err(FinanceDate.parse("2024-02-29 trailing")))
    assert (Result.is_err(FinanceDate.parse("0000-01-01")))
  end

  test "day arithmetic crosses leap days and year boundaries" do
    let leap = FinanceTestSupport.expect_ok(FinanceDate.parse("2024-02-28"))
    assert (FinanceDate.format(FinanceTestSupport.expect_ok(FinanceDate.add_days(leap, 1))) == "2024-02-29")
    assert (FinanceDate.format(FinanceTestSupport.expect_ok(FinanceDate.add_days(leap, 2))) == "2024-03-01")
    let year = FinanceTestSupport.expect_ok(FinanceDate.parse("2024-01-01"))
    assert (FinanceDate.format(FinanceTestSupport.expect_ok(FinanceDate.add_days(year, -1))) == "2023-12-31")
  end
end
